# GoldGuard application configuration
GOLDGUARD_ENVIRONMENT=development
GOLDGUARD_MODE=paper
GOLDGUARD_DATA_DIR=./data
GOLDGUARD_PAPER_STARTING_BALANCE=100
GOLDGUARD_SESSION_SECRET=replace-with-at-least-32-random-characters
GOLDGUARD_ADMIN_PASSWORD=replace-with-strong-admin-password
GOLDGUARD_ADMIN_TOTP_SECRET=replace-with-base32-totp-secret
GOLDGUARD_LIVE_CAPABILITY_ENABLED=false

# --- AI Provider Gateway (OpenCodex, second service) ---
# Keys stay in OpenCodex. GoldGuard only stores this shared token + the URL.
OPENCODEX_BASE_URL=http://opencodex:10100
OPENCODEX_API_AUTH_TOKEN=replace-with-random-data-plane-token
OPENCODEX_ADMIN_AUTH_TOKEN=replace-with-random-admin-auth-token
OPENCODEX_HOME=/data/opencodex

# Optional: seed OpenCodex with Gemini on first boot (or paste it in the dashboard)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Default model assignments (overridden from the Providers tab)
GOLDGUARD_DECISION_MODEL=google-antigravity/gemini-3.7-flash
GOLDGUARD_CONTEXT_MODEL=google-antigravity/gemini-3.7-flash
GOLDGUARD_HERMES_MODEL=google-antigravity/gemini-3.7-flash

# --- Hermes Autonomous Strategy Researcher ---
GOLDGUARD_HERMES_BASE_URL=http://hermes:8642
GOLDGUARD_HERMES_BRIDGE_TOKEN=replace-with-a-separate-random-service-key
HERMES_API_KEY=replace-with-a-separate-random-service-key
HERMES_BRIDGE_TOKEN=replace-with-a-separate-random-service-key

# --- Optional Binance Spot connection (PAXGUSDT only, withdrawals OFF) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
GOLDGUARD_LIVE_MAX_CAPITAL=0

# Runtime web port
PORT=8000
